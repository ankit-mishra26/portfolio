# Copy this file to .env.local for local development, and set the same names in Netlify.
# Never commit .env.local and never paste real keys into chats or code.

# Public site URL (canonical URL, sitemap, link previews). Set to your final address.
NEXT_PUBLIC_SITE_URL=https://regal-dolphin-32970b.netlify.app

# --- Contact form (Resend) ---
# The only value you must add. Create it at resend.com, then API Keys.
RESEND_API_KEY=
# Optional. Messages go to the email in data/socials.ts unless you set this.
# CONTACT_TO_EMAIL=
# Optional. Default sender works for testing; use your own verified domain for production.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Optional extras ---
# GITHUB_TOKEN=          # raises the GitHub API rate limit (server-only)
# ANTHROPIC_API_KEY=     # model-written Ask Ankit answers (the site works without it)
# ASK_MODEL=claude-haiku-5-5
